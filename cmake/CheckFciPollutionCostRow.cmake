# Reject mode fallthrough and stale CSVs as evidence for a cost row.
file(REMOVE "${output}")
execute_process(COMMAND "${executable}" cost_row sovinec "${method}" "${degree}"
    10 "${output}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Pollution cost row failed: ${result}")
endif()
if(NOT EXISTS "${output}")
    message(FATAL_ERROR "Pollution cost row did not produce its CSV")
endif()
file(STRINGS "${output}" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 2)
    message(FATAL_ERROR "Expected one cost row and its header, got ${row_count}")
endif()
list(GET rows 1 row)
if(NOT row MATCHES "^sovinec,${method},${degree},4,")
    message(FATAL_ERROR "Cost row has the wrong candidate or mesh: ${row}")
endif()
