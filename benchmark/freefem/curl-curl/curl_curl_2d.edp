// Independent FreeFEM implementation of the FortFEM interoperability Ampere
// case. This adapter is original FortFEM project code; FreeFEM is an external
// runtime and is not vendored.
//
// curl curl E + E = f on (0,1)^2, with zero tangential trace.
// E = (sin(pi*y), sin(pi*x))
// curl E = pi*(cos(pi*x) - cos(pi*y))
// f = (pi^2 + 1)*E

load "Element_Mixte"
verbosity = 0;
cout.precision(17);

func ExactEx = sin(pi*y);
func ExactEy = sin(pi*x);
func ExactCurl = pi*(cos(pi*x) - cos(pi*y));
func SourceX = (pi*pi + 1.0)*sin(pi*y);
func SourceY = (pi*pi + 1.0)*sin(pi*x);

ofstream results("ampere.csv");
results << "mesh_id,cells,dofs,h,l2_error,hcurl_error,"
        << "assembly_seconds,solve_seconds,total_seconds" << endl;

real previousL2 = -1.0;
real previousHcurl = -1.0;
for (int level = 0; level < 5; ++level) {
    int n = 4*2^level;
    mesh Th = square(n, n, [x, y]);
    fespace Vh(Th, RT0Ortho);
    Vh [Ex, Ey], [vx, vy];

    real totalStart = clock();
    real assemblyStart = clock();
    varf operatorForm([Ex, Ey], [vx, vy]) =
        int2d(Th, qforder=8)(
            (dx(Ey) - dy(Ex))*(dx(vy) - dy(vx))
            + Ex*vx + Ey*vy
        )
        + on(1, 2, 3, 4, Ex=0.0, Ey=0.0);
    varf loadForm([Ex, Ey], [vx, vy]) =
        int2d(Th, qforder=8)(SourceX*vx + SourceY*vy)
        + on(1, 2, 3, 4, Ex=0.0, Ey=0.0);
    matrix A = operatorForm(Vh, Vh, solver=UMFPACK);
    real[int] b = loadForm(0, Vh);
    real assemblySeconds = clock() - assemblyStart;

    real solveStart = clock();
    Ex[] = A^-1*b;
    real solveSeconds = clock() - solveStart;
    real totalSeconds = clock() - totalStart;

    real l2Squared = int2d(Th, qforder=10)(
        (Ex - ExactEx)^2 + (Ey - ExactEy)^2
    );
    real curlSquared = int2d(Th, qforder=10)(
        (dx(Ey) - dy(Ex) - ExactCurl)^2
    );
    real l2Error = sqrt(l2Squared);
    real hcurlError = sqrt(l2Squared + curlSquared);

    results << "unit-square-n" << n << ","
            << Th.nt << "," << Vh.ndof << "," << 1.0/n << ","
            << l2Error << "," << hcurlError << ","
            << assemblySeconds << "," << solveSeconds << ","
            << totalSeconds << endl;

    if (previousL2 > 0.0 && l2Error >= previousL2) {
        cerr << "L2 error did not decrease at n=" << n << endl;
        exit(2);
    }
    if (previousHcurl > 0.0 && hcurlError >= previousHcurl) {
        cerr << "H(curl) error did not decrease at n=" << n << endl;
        exit(3);
    }
    previousL2 = l2Error;
    previousHcurl = hcurlError;
}

cout << "wrote ampere.csv" << endl;
