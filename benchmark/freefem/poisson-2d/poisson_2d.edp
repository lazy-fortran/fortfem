// Independent FreeFEM implementation of the FortFEM interoperability Poisson
// case. FreeFEM is an external runtime and is not vendored.
//
// -Delta u = f on (0,1)^2, u=0 on the boundary.
// u = sin(pi*x)*sin(pi*y), f = 2*pi^2*u.

verbosity = 0;
cout.precision(17);

func ExactU = sin(pi*x)*sin(pi*y);
func ExactDx = pi*cos(pi*x)*sin(pi*y);
func ExactDy = pi*sin(pi*x)*cos(pi*y);
func Source = 2.0*pi*pi*sin(pi*x)*sin(pi*y);

ofstream results("poisson.csv");
results << "mesh_id,cells,dofs,h,l2_error,h1_error,"
        << "assembly_seconds,solve_seconds,total_seconds" << endl;

real previousL2 = -1.0;
real previousH1 = -1.0;
for (int level = 0; level < 5; ++level) {
    int n = 4*2^level;
    mesh Th = square(n, n, [x, y]);
    fespace Vh(Th, P1);
    Vh u, v;

    real totalStart = clock();
    real assemblyStart = clock();
    varf operatorForm(u, v) =
        int2d(Th, qforder=8)(dx(u)*dx(v) + dy(u)*dy(v))
        + on(1, 2, 3, 4, u=0.0);
    varf loadForm(u, v) =
        int2d(Th, qforder=8)(Source*v)
        + on(1, 2, 3, 4, u=0.0);
    matrix A = operatorForm(Vh, Vh, solver=UMFPACK);
    real[int] b = loadForm(0, Vh);
    real assemblySeconds = clock() - assemblyStart;

    real solveStart = clock();
    u[] = A^-1*b;
    real solveSeconds = clock() - solveStart;
    real totalSeconds = clock() - totalStart;

    real l2Squared = int2d(Th, qforder=10)((u - ExactU)^2);
    real gradientSquared = int2d(Th, qforder=10)(
        (dx(u) - ExactDx)^2 + (dy(u) - ExactDy)^2
    );
    real l2Error = sqrt(l2Squared);
    real h1Error = sqrt(l2Squared + gradientSquared);

    results << "unit-square-n" << n << ","
            << Th.nt << "," << Vh.ndof << "," << 1.0/n << ","
            << l2Error << "," << h1Error << ","
            << assemblySeconds << "," << solveSeconds << ","
            << totalSeconds << endl;

    if (previousL2 > 0.0 && l2Error >= previousL2) {
        cerr << "L2 error did not decrease at n=" << n << endl;
        exit(2);
    }
    if (previousH1 > 0.0 && h1Error >= previousH1) {
        cerr << "H1 error did not decrease at n=" << n << endl;
        exit(3);
    }
    previousL2 = l2Error;
    previousH1 = h1Error;
}

cout << "wrote poisson.csv" << endl;
