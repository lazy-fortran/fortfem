  "case_workflow": {
    "steps": [
      "inventory private references by logical source ID",
      "classify rights and record public provenance",
      "transcribe only geometry, regions, units, boundary conditions, excitations, and probe locations",
      "generate a neutral or FortSym manufactured case when exact arrays are not licensed",
      "validate the external payload manifest and checksum before exact execution",
      "run the independent solver adapter on the common physical sample set",
      "render system geometry and the computed solution before diagnostics",
      "publish CSV/JSON provenance and generated SVG/PNG to Pages; keep media untracked"
    ],
    "plot_order": [
      "system geometry, mesh or spline patches, regions, coils, interfaces, and boundary labels",
      "computed scalar solution, vector arrows, surface field, or field lines",
      "analytical or external-reference comparison",
      "error, convergence, conservation, derivative, and performance diagnostics"
    ],
    "acceptance": "Every Paper Magnetic and TEAM case must have a solution-first gallery record, an independent behavioral oracle, common physical probes, provenance JSON, and an explicit skip until exact rights and checksums are available."
  }
