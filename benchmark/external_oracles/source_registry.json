  "purpose": "Public provenance and extraction inventory; no protected source files or numerical payloads are embedded.",
  "data_policy": {
    "public_repository_may_contain": [
      "bibliographic metadata and public provenance URLs",
      "manually reviewed geometry topology and dimensions",
      "region and material labels",
      "boundary, interface, excitation, and normalization declarations",
      "probe coordinates and generated meshes when their license permits",
      "FortSym-generated manufactured fields, source terms, and analytical references"
    ],
    "must_remain_external": [
      "publisher PDFs and scans",
      "copyrighted figures and tables",
      "raw reference measurements and unlicensed probe arrays",
      "private meshes, source code, scripts, and solver output",
      "non-redistributable B-H curves or other proprietary constitutive data"
    ],
    "external_payload_repository": "https://github.com/lazy-fortran/fortfem-benchmark-data",
    "publication_gate": "A case becomes exact-data enabled only after license review, immutable manifest, SHA-256 checksum, and a solution-first gallery record are available."
  },
